+// Permuted store (Codex, V100): the same gated elementwise op, but the result of element
+// `i = i0*(ni_no) + i1*no + i2` is written to the contiguous slot
+// `o = i0*(no*ni) + i2*ni + i1` -- i.e. the (i0, no, ni) -> (i0, ni, no) deinterleave the
+// graph otherwise materialises with RESHAPE -> PERMUTE -> CONT before the Hadamard FWHT.
+// Writing it here removes that copy and its launch; the arithmetic per element is
+// unchanged (same operands, same order), only the destination address differs, so the
+// downstream FWHT still reads byte-identical data.
+template <float (*op)(float), typename T>
+static __global__ void unary_gated_permuted_op_kernel(const T * x, const T * g, T * dst,
+        const int64_t k, const int64_t rows, const int64_t ni, const int64_t no) {
+    ggml_cuda_pdl_lc();
+    const int64_t q = int64_t(blockDim.x)*blockIdx.x + threadIdx.x;
+
+    if (q >= k) {
+        return;
+    }
+
+    // ggml memory order: dim 0 is the innermost. The CONT destination has shape
+    // (rows, no, ni) and holds the (rows, ni, no) source permuted by (0,2,1):
+    //   dst(q = (i0, j1, j2)) = src(i0, i1 = j2, i2 = j1)
+    // with flat indices q = i0 + j1*rows + j2*rows*no and i = i0 + j2*rows + j1*rows*ni.
+    const int64_t i0 = q % rows;
+    const int64_t j1 = (q / rows) % no;
+    const int64_t j2 = q / (rows * no);
+    const int64_t i  = i0 + j2 * rows + j1 * rows * ni;
+
+    ggml_cuda_pdl_sync();
+    dst[q] = (T)(op((float)x[i]) * (float)g[i]);
+}
