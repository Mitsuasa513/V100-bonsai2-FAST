+static void unary_gated_permuted_cuda(const T * x, const T * g, T * dst, const int64_t k,
+                                      const int64_t rows, const int64_t ni, const int64_t no, cudaStream_t stream) {
+    const int64_t num_blocks = (k + CUDA_GLU_BLOCK_SIZE - 1) / CUDA_GLU_BLOCK_SIZE;
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params((dim3)num_blocks, CUDA_GLU_BLOCK_SIZE, 0, stream);
+    ggml_cuda_kernel_launch(unary_gated_permuted_op_kernel<op, T>, launch_params, x, g, dst, k, rows, ni, no);
