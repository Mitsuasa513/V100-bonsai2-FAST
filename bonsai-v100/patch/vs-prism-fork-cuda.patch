index f597088..f2efe32 100644
--- a/ggml/src/ggml-cuda/concat.cu
+++ b/ggml/src/ggml-cuda/concat.cu
@@ -2,6 +2,100 @@
 
 #include <stdint.h>
 
+// ---------------------------------------------------------------------------
+// delta-net conv state: gather + concat in one launch (Codex, 2026-09-28)
+//
+// Layouts (all F32, conv state row length KS*C = conv_kernel-1 rows of C channels):
+//   state     : recurrent cache rows, one row per cell/slot: KS*C floats each
+//   rows      : per-sequence cache row index (the elided GET_ROWS' src[1])
+//   qkv       : strided (T, C, B) input (the transposed qkv of this ubatch)
+//   dst_cat   : (KS + T, C, B) contiguous -> the buffer SSM_CONV reads
+//
+// Element (r, c, b) of dst_cat is taken from the state row when r < KS and from qkv
+// row (r - KS) otherwise. The new conv state (the last KS rows of dst_cat) is
+// deliberately *not* written here: doing that in the same launch both reads and writes
+// the same cache rows that the concatenation above reads, and for T < KS those
+// accesses overlap (row X of the new state comes from row X+T of the old one), which is
+// an unsynchronised read-after-write across blocks -- measured as run-to-run differing
+// logits (up to 2e-1) at T = 1. The graph's own strided CPY does the write-back
+// instead; only the per-layer GET_ROWS is elided.
+template <typename src_t>
+static __global__ void __launch_bounds__(CUDA_CONCAT_BLOCK_SIZE) conv_state_concat(
+        const char *   __restrict__ state,
+        const int32_t * __restrict__ rows,
+        const char *   __restrict__ qkv,
+              char *   __restrict__ dst_cat,
+        int64_t state_row_stride,
+        int64_t C, int64_t T, int64_t B, int64_t KS,
+        int64_t nb_qkv0, int64_t nb_qkv1, int64_t nb_qkv2,
+        int64_t nb_cat1, int64_t nb_cat2) {
+    const int64_t rows_cat = KS + T;
+    const int64_t n_cat    = rows_cat * C * B;
+
+    // Every index space follows its tensor's memory order (dim 0 innermost), so
+    // consecutive threads touch consecutive addresses: the concatenation writes and the
+    // reads of the live state (cache[c*KS + r] is contiguous in r) are fully coalesced.
+    for (int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x; i < n_cat;
+         i += (int64_t) blockDim.x * gridDim.x) {
+        // dst_cat element (row, c, b)
+        const int64_t row = i % rows_cat;
+        const int64_t c   = (i / rows_cat) % C;
