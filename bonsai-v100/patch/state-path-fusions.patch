+// decided to fold the graph's CPY into the conv kernel (decode only); see
+// ggml_cuda_match_conv_state_update. Entries are keyed by the conv node itself.
+static ggml_cuda_state_rows_read * ggml_cuda_take_conv_state_wb(ggml_backend_cuda_context * cuda_ctx, const ggml_tensor * node) {
+    const auto it = cuda_ctx->state_rows_read.find(node);
