+    if (rows->type != GGML_TYPE_F32 || !ggml_is_contiguous(rows) || rows->nb[0] != sizeof(float) ||
+        rows->view_src == nullptr || rows->data == nullptr || rows->ne[0] != gr->ne[0] ||
+        gr->ne[1] != idx->ne[0]) {
