+    const ggml_tensor * view = l2->src[0];
+
+    if (view == nullptr || view->type != GGML_TYPE_F32 || view->view_src == nullptr ||
+        view->nb[0] != sizeof(float) || view->nb[1] != 128 * sizeof(float) ||
+        view->ne[0] != l2->ne[0] || view->ne[1] != l2->ne[1] || view->ne[2] != 1) {
+        return false;
+    }
+
+    // the fold rides on the alpha/beta pair matvec, which must come later in the graph
+    for (int j = l2_idx + 1; j < cgraph->n_nodes; ++j) {
+        if (cgraph->nodes[j]->op != GGML_OP_MUL_MAT) {
+            continue;
+        }
+
+        int second_idx = -1;
+        if (ggml_cuda_match_mul_mat_vec_f_pair(cgraph, j, second_idx)) {
+            pair_idx = j;
+            return true;
+        }
+        return false; // the first matvec after the norm is not a matvec pair -> leave it alone
+    }
+
+    return false;
+}
+
+// Deinterleaving GLU store (Codex, V100): the Hadamard path wants the GDN output in a
+// permuted layout, which the graph expresses as RESHAPE(rows, ni, no) -> PERMUTE(0,2,1)
+// -> CONT. The CONT is a pure copy whose only purpose is that deinterleave, so instead of
+// running it we let the producing SWIGLU store its result already permuted into the CONT's
+// output tensor (ggml_cuda_op_swiglu_permuted). Everything downstream (the sign MUL and
+// the FWHT) then reads byte-identical data from the same buffer, with one less launch and
+// one less 24 KB copy per layer.
+//
+// Conservative: the GLU must be a two-operand contiguous F32 SWIGLU, the chain in between
+// may only contain view/noop nodes, and neither the GLU output nor the intermediate views
+// may be referenced by any other node.
+static bool ggml_cuda_match_glu_permuted_store(
+        const ggml_cgraph * cgraph, int glu_idx, int & cont_idx, int64_t & ni, int64_t & no) {
+    const ggml_tensor * glu = cgraph->nodes[glu_idx];
+
+    if (glu->op != GGML_OP_GLU || ggml_get_glu_op(glu) != GGML_GLU_OP_SWIGLU ||
+        glu->type != GGML_TYPE_F32 || glu->src[0] == nullptr || glu->src[1] == nullptr ||
+        glu->src[0]->type != GGML_TYPE_F32 || glu->src[1]->type != GGML_TYPE_F32 ||
+        (glu->flags & GGML_TENSOR_FLAG_OUTPUT) != 0 || ggml_is_empty(glu) ||
+        glu->ne[2] != 1 || glu->ne[3] != 1 ||
+        !ggml_is_contiguous(glu) || !ggml_is_contiguous(glu->src[0]) || !ggml_is_contiguous(glu->src[1]) ||
+        !ggml_are_same_shape(glu->src[0], glu->src[1])) {
+        return false;
+    }
+
+    // walk the view/noop chain from the GLU to the CONT
+    std::vector<const ggml_tensor *> chain = { glu };
+    const ggml_tensor * cont = nullptr;
+
+    for (int j = glu_idx + 1; j < cgraph->n_nodes && cont == nullptr; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+
+        bool refs = false;
+        for (uint32_t s = 0; s < GGML_MAX_SRC; ++s) {
+            if (n->src[s] != nullptr &&
+                    std::find(chain.begin(), chain.end(), n->src[s]) != chain.end()) {
+                refs = true;
+                break;
+            }
+        }
+
+        if (ggml_cuda_is_view_or_noop(n)) {
+            if (refs) {
+                chain.push_back(n);
+            }
+            continue;
+        }
+        if (!refs) {
+            continue;
+        }
+        if (n->op != GGML_OP_CONT || n->type != GGML_TYPE_F32 || ggml_is_empty(n)) {
+            return false; // first real consumer is not the CONT
+        }
+        cont = n;
+    }
+
+    if (cont == nullptr || chain.size() < 2) {
+        return false;
+    }
+
+    // the last node before the CONT must be the PERMUTE(0,2,1) of a (rows, ni, no) reshape
+    const ggml_tensor * perm = chain.back();
+    const ggml_tensor * res  = perm->src[0];
+
+    if (perm->op != GGML_OP_PERMUTE || res == nullptr || res->op != GGML_OP_RESHAPE ||
+        std::find(chain.begin(), chain.end(), res) == chain.end()) {
+        return false;
+    }
+    if (ggml_get_op_params_i32(perm, 0) != 0 || ggml_get_op_params_i32(perm, 1) != 2 ||
+        ggml_get_op_params_i32(perm, 2) != 1 || ggml_get_op_params_i32(perm, 3) != 3) {
+        return false;
+    }
+    if (res->ne[0] != glu->ne[0] || res->ne[3] != 1 ||
+        res->ne[1] * res->ne[2] != glu->ne[1] || res->ne[1] == 1 || res->ne[2] == 1) {
+        return false;
+    }
+    if (cont->ne[0] != res->ne[0] || cont->ne[1] != res->ne[2] || cont->ne[2] != res->ne[1] ||
+        cont->ne[3] != 1 || !ggml_is_contiguous(cont) || ggml_nelements(cont) != ggml_nelements(glu)) {
+        return false;
+    }
+
+    // nothing else may reference the GLU output or the intermediate views
+    for (int j = glu_idx + 1; j < cgraph->n_nodes; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+
+        if (n == cont || std::find(chain.begin(), chain.end(), n) != chain.end()) {
+            continue;
+        }
+        for (uint32_t s = 0; s < GGML_MAX_SRC; ++s) {
+            if (n->src[s] != nullptr &&
+                    std::find(chain.begin(), chain.end(), n->src[s]) != chain.end()) {
+                return false;
+            }
+        }
+    }
+
+    cont_idx = -1;
+    for (int j = glu_idx + 1; j < cgraph->n_nodes; ++j) {
+        if (cgraph->nodes[j] == cont) {
+            cont_idx = j;
+            break;
+        }
+    }
+    if (cont_idx < 0) {
+        return false;
+    }
+
+    ni = res->ne[1];
+    no = res->ne[2];
+
+    return true;
+}
+
+// delta-net conv state (Codex, 2026-09-28): the graph expresses the per-layer conv state
+// update as GET_ROWS(live row) -> RESHAPE -> CONCAT(transposed qkv) -> [views] -> CPY(new
+// state), i.e. three small kernels of pure data movement. Match the whole thing so the
+// conv state can be read from the recurrent cache row directly and the concatenation can
+// be produced by one kernel (ggml_cuda_op_conv_state_concat). The write-back CPY is left
+// alone: folding it into the same launch races with the concatenation's own reads (see
+// the note at the end of this matcher).
+//
+// Conservative on purpose:
+//   * the gathered rows must have exactly one consumer chain, ending in a CONCAT on dim 0
+//   * the first real node after the CONCAT must be the strided CPY of the last
+//     (conv_kernel-1) rows into the very same cache the rows were read from
+//   * no second such CPY for this CONCAT (that is the K > 1 rollback ring -> leave it alone)
+//   * nothing non-empty in between may touch the cache
+static bool ggml_cuda_match_conv_state_update(
+        const ggml_cgraph * cgraph, int getrows_idx, int & concat_idx, int & ssm_conv_idx,
+        ggml_cuda_state_rows_read & out,
+        const char ** why = nullptr) {
+#define CONV_REJECT(reason) do { if (why != nullptr) { *why = reason; } return false; } while (0)
+    const ggml_tensor * gr = cgraph->nodes[getrows_idx];
+
+    if (gr->op != GGML_OP_GET_ROWS || gr->type != GGML_TYPE_F32 ||
+        (gr->flags & GGML_TENSOR_FLAG_OUTPUT) != 0 || ggml_is_empty(gr)) {
+        CONV_REJECT("not a f32 get_rows");
+    }
+
+    const ggml_tensor * idx  = gr->src[1];
+    const ggml_tensor * rows = gr->src[0];
+
+    if (idx == nullptr || rows == nullptr || idx->type != GGML_TYPE_I32 || idx->data == nullptr ||
+        !ggml_is_contiguous(idx) || idx->ne[0] <= 0 || idx->ne[1] != 1) {
+        CONV_REJECT("bad index tensor");
+    }
+    if (rows->type != GGML_TYPE_F32 || !ggml_is_contiguous(rows) || rows->nb[0] != sizeof(float) ||
+        rows->view_src == nullptr || rows->data == nullptr ||
+        rows->ne[0] != gr->ne[0] || gr->ne[1] != idx->ne[0]) {
+        CONV_REJECT("bad gather source");
+    }
+
+    const ggml_tensor * cache = rows->view_src;
+    const int64_t row_elems  = rows->ne[0];
+    const int64_t row_stride = (int64_t) (rows->nb[1] / sizeof(float));
+
+    if (row_stride < row_elems) {
+        CONV_REJECT("row stride < row size");
+    }
+
+    // find the CONCAT consuming the gathered rows (only view/noop nodes in between)
+    std::vector<const ggml_tensor *> derived = { gr };
+    int found = -1;
+
+    for (int j = getrows_idx + 1; j < cgraph->n_nodes; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+
+        bool refs_derived = false;
+        for (uint32_t s = 0; s < GGML_MAX_SRC; ++s) {
+            if (n->src[s] != nullptr &&
+                    std::find(derived.begin(), derived.end(), n->src[s]) != derived.end()) {
+                refs_derived = true;
+                break;
+            }
+        }
+
+        if (ggml_cuda_is_view_or_noop(n)) {
+            if (refs_derived) {
+                derived.push_back(n);
+            }
+            continue;
+        }
+
+        if (refs_derived && n->op == GGML_OP_CONCAT && n->type == GGML_TYPE_F32 &&
+                n->src[0] != nullptr && n->src[1] != nullptr && ggml_get_op_params_i32(n, 0) == 0 &&
+                std::find(derived.begin(), derived.end(), n->src[0]) != derived.end()) {
+            found = j;
+            break;
+        }
+
+        if (refs_derived) {
+            CONV_REJECT("non-concat consumer of the rows"); // second, non-view consumer
+        }
+    }
+
+    if (found < 0) {
+        CONV_REJECT("no concat consumer");
+    }
+
+    const ggml_tensor * cat   = cgraph->nodes[found];
+    const ggml_tensor * qkv_t = cat->src[1];
+
+    if (!ggml_is_contiguous(cat) || qkv_t->type != GGML_TYPE_F32 || qkv_t->ne[0] <= 0) {
+        CONV_REJECT("concat output/qkv shape");
+    }
+
+    const int64_t C  = cat->ne[1];
+    const int64_t B  = cat->ne[2];
+    const int64_t T  = qkv_t->ne[0];
+    const int64_t KS = row_elems / C; // conv_kernel - 1
+
+    if (C <= 0 || B <= 0 || KS < 1 || KS * C != row_elems || cat->ne[0] != KS + T ||
+        cat->ne[3] != 1 || qkv_t->ne[1] != C || qkv_t->ne[2] != B) {
+        CONV_REJECT("conv state / concat geometry");
+    }
+
+    // (the fused kernel indexes every operand in the tensors' own memory order, so it
+    // scales to long prompts as well; verified against the graph's ops at pp8192)
+
+    // the first real node after the CONCAT must be its write-back CPY
+    const ggml_tensor * cpy = nullptr;
+    int cpy_idx = -1;
+
+    for (int j = found + 1; j < cgraph->n_nodes && cpy == nullptr; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(n)) {
+            continue;
+        }
+        if (n->op != GGML_OP_CPY || (n->flags & GGML_TENSOR_FLAG_OUTPUT) != 0) {
+            CONV_REJECT("first node after concat is not a cpy");
+        }
+        cpy     = n;
+        cpy_idx = j;
+    }
+
+    if (cpy == nullptr) {
+        CONV_REJECT("no write-back cpy after concat");
+    }
+
+    const ggml_tensor * src_view = cpy->src[0]; // last KS rows of the concatenation
+    const ggml_tensor * dst_view = cpy->src[1]; // destination cache row(s)
+
+    // note: src_view is a strided slice of conv_input (its rows span the parent's planes),
+    // so it is intentionally not required to be contiguous — the fused kernel rebuilds the
+    // same bytes from the cache row and the qkv input instead of reading this view
+    // the "last KS rows" slice skips T elements along dim 0 (element offset, not a whole
+    // row of C*B elements) and spans the parent's planes via the inherited nb[1]/nb[2]
+    if (src_view == nullptr || dst_view == nullptr || src_view->op != GGML_OP_VIEW ||
+        src_view->view_src != cat ||
+        src_view->view_offs != (size_t) T * sizeof(float) ||
+        src_view->ne[0] != KS || src_view->ne[1] != C || src_view->ne[2] != B) {
+        if (why != nullptr) {
+            static char conv_src_msg[320];
+            snprintf(conv_src_msg, sizeof(conv_src_msg),
+                     "cpy src view mismatch: op=%s view_src==cat:%d offs=%lld want=%lld ne=(%lld,%lld,%lld) want=(%lld,%lld,%lld)",
+                     ggml_op_name(src_view->op), (int) (src_view->view_src == cat),
+                     (long long) src_view->view_offs, (long long) ((int64_t) T * (int64_t) sizeof(float)),
+                     (long long) src_view->ne[0], (long long) src_view->ne[1], (long long) src_view->ne[2],
+                     (long long) KS, (long long) C, (long long) B);
+            *why = conv_src_msg;
+        }
+        return false;
+    }
+
+    if (dst_view->op != GGML_OP_VIEW || dst_view->type != GGML_TYPE_F32 || dst_view->data == nullptr ||
+        dst_view->ne[0] != KS * C || dst_view->ne[1] != B || dst_view->nb[0] != sizeof(float) ||
+        dst_view->nb[1] != (size_t) row_stride * sizeof(float)) {
+        CONV_REJECT("cpy destination view mismatch");
+    }
+
+    // the write-back must target the very cache the state rows were read from
+    if ((dst_view->view_src != nullptr ? dst_view->view_src : dst_view) != cache) {
+        CONV_REJECT("write-back targets another tensor");
+    }
+
+    // K > 1 (rollback ring) emits several of these copies -> keep the graph as is
+    for (int j = cpy_idx + 1; j < cgraph->n_nodes; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (n->op == GGML_OP_SSM_CONV) {
+            break;
+        }
+        if (n->op == GGML_OP_CPY && n->src[0] != nullptr && n->src[0]->view_src == cat) {
+            CONV_REJECT("multiple write-back copies (K > 1)");
+        }
+    }
+
+    // nothing non-empty in between may modify the cache rows the kernel will read
+    for (int j = getrows_idx + 1; j < found; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (ggml_is_empty(n)) {
+            continue; // empty nodes are skipped at runtime (see ggml_cuda_is_view_or_noop)
+        }
+        for (uint32_t s = 0; s < GGML_MAX_SRC; ++s) {
+            const ggml_tensor * t = n->src[s];
+            if (t == nullptr) {
+                continue;
+            }
+            if ((t->view_src != nullptr ? t->view_src : t) == cache) {
+                CONV_REJECT("cache touched between gather and concat");
+            }
+        }
+    }
+
+    out.state_base = (const float *)   rows->data;
+    out.rows       = (const int32_t *) idx->data;
+    out.row_stride = row_stride;
+    out.dst_view   = dst_view;
+    out.consumed   = false;
+    concat_idx     = found;
+    ssm_conv_idx   = -1;
+
+    // NOTE (Codex, 2026-09-28): the write-back CPY must NOT be folded into the same
+    // launch as the gather+concat: new state row X is built from old cache row X+T, and
+    // for T < KS those accesses overlap, so one kernel would read a cache row another
+    // block is concurrently overwriting (measured as run-to-run differing decode
+    // logits, up to 2e-1). Folding it into the *conv consumer* instead is safe -- that
+    // kernel only reads the concatenation and only writes the cache -- so do that for
+    // the short-kernel path (T <= 32, i.e. decode) and leave the CPY in the graph
+    // otherwise. The state is written to the very tensor the CPY targeted, with the
+    // same bytes.
+    out.skip = 0;
+
+    if (T <= 32 && dst_view->data != nullptr) {
+        // Walk forward to the conv consumer. Other per-layer ops may sit in between (the
+        // GDN state scan is computed here), so require that none of them touches this
+        // cache: a reader would see the pre-update state once the write moves into the
+        // conv kernel, and a writer would be reordered past it.
+        bool cache_untouched = true;
+        int  ssm_idx         = -1;
+
+        for (int j = cpy_idx + 1; j < cgraph->n_nodes; ++j) {
+            const ggml_tensor * n = cgraph->nodes[j];
+
+            if (n->op == GGML_OP_SSM_CONV) {
+                ssm_idx = j;
+                break;
+            }
+            if (ggml_cuda_is_view_or_noop(n)) {
+                continue;
+            }
+            if ((n->view_src != nullptr ? n->view_src : n) == cache) {
+                cache_untouched = false; // the op writes into the cache
+                break;
+            }
+            for (uint32_t s = 0; s < GGML_MAX_SRC; ++s) {
+                const ggml_tensor * t = n->src[s];
+                if (t != nullptr && (t->view_src != nullptr ? t->view_src : t) == cache) {
+                    cache_untouched = false; // the op reads the cache
+                    break;
+                }
+            }
+            if (!cache_untouched) {
+                break;
+            }
+        }
+
+        if (cache_untouched && ssm_idx >= 0) {
+            const ggml_tensor * conv = cgraph->nodes[ssm_idx];
+
+            if (conv->type == GGML_TYPE_F32 && conv->src[0] == cat && conv->src[1] != nullptr) {
+                ssm_conv_idx = ssm_idx;
+                out.skip     = cpy_idx - found; // the conv kernel produces the write-back
+            }
+        }
+    }
+
+    return true;
+#undef CONV_REJECT
+}
+
+// Per-layer matvec pair (Codex, V100): ssm_alpha and ssm_beta are two (d_inner -> 48)
+// matvecs over the very same activation, i.e. two launches and two activation reads per
+// layer. Both are plain mul_mat_vec_f nodes, so they can be evaluated by one launch whose
+// second half replays the identical code path (ggml_cuda_mul_mat_vec_f_pair) -- the
+// results stay bit-identical. Conservative: the second matvec must be the first real
+// consumer of the first one (only view/noop nodes in between), read the identical src1
+// tensor, and use the same kernel the plain dispatch would pick.
+static bool ggml_cuda_match_mul_mat_vec_f_pair(const ggml_cgraph * cgraph, int idx, int & second_idx) {
+    const ggml_tensor * a = cgraph->nodes[idx];
+    const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+
+    // exactly the condition under which the plain dispatch picks the mul_mat_vec_f kernel
+    const auto uses_mmvf = [cc](const ggml_tensor * t) {
+        return t->src[0] != nullptr && t->src[1] != nullptr &&
+               t->type == GGML_TYPE_F32 && t->src[1]->type == GGML_TYPE_F32 &&
+               t->src[0]->view_src == nullptr && t->ne[1] == 1 && t->ne[2] == 1 && t->ne[3] == 1 &&
+               t->src[0]->ne[2] == 1 && t->src[0]->ne[3] == 1 && t->src[1]->ne[1] == 1 &&
+               ggml_is_contiguous(t) && ggml_is_contiguous(t->src[0]) &&
+               ggml_cuda_should_use_mmvf(t->src[0]->type, cc, t->src[0]->ne, t->src[0]->nb, t->src[1]->ne[1]);
+    };
+
+    if (a->op != GGML_OP_MUL_MAT || (a->flags & GGML_TENSOR_FLAG_OUTPUT) != 0 || !uses_mmvf(a)) {
+        return false;
+    }
+
+    // The second half of the pair must follow immediately except for view/noop nodes --
+    // those are not dispatched anyway, so skipping their positions is harmless.
+    for (int j = idx + 1; j < cgraph->n_nodes; ++j) {
+        const ggml_tensor * b = cgraph->nodes[j];
+
+        if (ggml_cuda_is_view_or_noop(b)) {
+            continue;
+        }
+        if (b->op != GGML_OP_MUL_MAT || (b->flags & GGML_TENSOR_FLAG_OUTPUT) != 0 ||
+            b->src[1] != a->src[1] || b->src[0]->type != a->src[0]->type ||
+            !ggml_are_same_shape(b->src[0], a->src[0]) || !ggml_are_same_shape(b, a) || !uses_mmvf(b)) {
+            return false;
+        }
+
+        second_idx = j;
+        return true;
+    }
+
+    return false;
 }
 
