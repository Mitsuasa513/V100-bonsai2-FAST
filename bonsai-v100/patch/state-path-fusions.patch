+// Hadamard rotation -> q8_1 (Codex, V100, 2026-10-01).
+//
+// The rotation output is read by one or more quantized matvecs through a contiguous view of it
+// ((1024, 5) -> (5120, 1) in this model), and each of those quantizes that activation to q8_1 with
+// a launch of its own - a full extra read of an activation that the transform has in registers
+// already. The bytes are a pure function of the transform output (32-element blocks, one warp
+// reduction each), so the transform can write them itself (fwht.cu) and the matvec then finds the
+// slot filled in the q8_1 cache and skips the launch.
+//
+// The slot is booked under the *consumer's* tensor, which is why the consumer chain has to be
+// resolved here rather than inside the transform. GGML_CUDA_FWHT_Q8_1=0 restores the separate
+// quantizer for A/B.
+static bool ggml_cuda_fwht_q8_enabled() {
+    static const bool enabled = []() {
+        const char * env = getenv("GGML_CUDA_FWHT_Q8_1");
+        return env == nullptr || atoi(env) != 0;
+    }();
+    return enabled;
+}
+
+// Finds the tensor the matvecs of this rotation quantize: the transform output itself or a
+// contiguous view of it (same elements, same flat order, no row padding) that is read as src1 by at
+// least one MUL_MAT which takes the MMVQ path - the only user of the q8_1 cache. Returns false when
+// the shape, the view or the consumers do not qualify, and the quantization stays where it was.
+static bool ggml_cuda_match_fwht_q8(const ggml_cgraph * cgraph, const int mm_idx, const ggml_tensor * mm,
+                                    const ggml_tensor ** src_out) {
